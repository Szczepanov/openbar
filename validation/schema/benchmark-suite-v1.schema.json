{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbar.local/schemas/benchmark-suite-v1.schema.json",
  "title": "OpenBar M0 tracker benchmark suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pipeline_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "pipeline_version": {"type": "string", "minLength": 1},
    "git_commit": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_s", "end_s"],
      "properties": {
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fixture_manifest",
        "fixture_id",
        "annotations",
        "predictions",
        "selected_range_s",
        "timestamp_tolerance_s",
        "min_confidence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "fixture_manifest": {"type": "string", "minLength": 1},
        "fixture_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "annotations": {"type": "string", "minLength": 1},
        "manual_seed": {"type": "string", "minLength": 1},
        "predictions": {"type": "string", "minLength": 1},
        "selected_range_s": {"$ref": "#/$defs/range"},
        "timestamp_tolerance_s": {"type": "number", "minimum": 0},
        "min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
