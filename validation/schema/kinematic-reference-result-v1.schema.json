{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbar.dev/schema/kinematic-reference-result-v1.schema.json",
  "title": "OpenBar independent kinematic reference result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "evidence_class",
    "purpose",
    "reference",
    "construct",
    "summary",
    "cases",
    "gates",
    "limitations"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "study_id": { "type": "string", "minLength": 1 },
    "evidence_class": { "const": "independent_physical_reference" },
    "purpose": { "type": "string", "minLength": 1 },
    "reference": { "type": "object", "additionalProperties": true },
    "construct": { "type": "object", "additionalProperties": true },
    "summary": { "$ref": "#/$defs/summary" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case_result" }
    },
    "gates": { "$ref": "#/$defs/gates" },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_cases",
        "evaluated_cases",
        "failed_supported_cases",
        "unsupported_cases",
        "evaluated_reference_samples"
      ],
      "properties": {
        "total_cases": { "type": "integer", "minimum": 0 },
        "evaluated_cases": { "type": "integer", "minimum": 0 },
        "failed_supported_cases": { "type": "integer", "minimum": 0 },
        "unsupported_cases": { "type": "integer", "minimum": 0 },
        "evaluated_reference_samples": { "type": "integer", "minimum": 0 }
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["position_m", "velocity_mps", "method"],
      "properties": {
        "position_m": { "type": "number", "minimum": 0 },
        "velocity_mps": { "type": "number", "minimum": 0 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "mae",
        "rmse",
        "bias",
        "p50_absolute",
        "p90_absolute",
        "p95_absolute",
        "max_absolute"
      ],
      "properties": {
        "count": { "type": "integer", "minimum": 1 },
        "mae": { "type": "number", "minimum": 0 },
        "rmse": { "type": "number", "minimum": 0 },
        "bias": { "type": "number" },
        "p50_absolute": { "type": "number", "minimum": 0 },
        "p90_absolute": { "type": "number", "minimum": 0 },
        "p95_absolute": { "type": "number", "minimum": 0 },
        "max_absolute": { "type": "number", "minimum": 0 }
      }
    },
    "case_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "calibrated_position_error_m",
        "reference_rom_m",
        "openbar_rom_m",
        "rom_error_m",
        "reference_mean_velocity_mps",
        "openbar_mean_velocity_mps",
        "mean_velocity_error_mps",
        "reference_peak_velocity_mps",
        "reference_peak_timestamp_s",
        "openbar_peak_velocity_mps",
        "openbar_peak_timestamp_s",
        "peak_velocity_error_mps"
      ],
      "properties": {
        "calibrated_position_error_m": { "$ref": "#/$defs/distribution" },
        "reference_rom_m": { "type": "number", "minimum": 0 },
        "openbar_rom_m": { "type": "number", "minimum": 0 },
        "rom_error_m": { "type": "number" },
        "reference_mean_velocity_mps": { "type": "number" },
        "openbar_mean_velocity_mps": { "type": "number" },
        "mean_velocity_error_mps": { "type": "number" },
        "reference_peak_velocity_mps": { "type": "number" },
        "reference_peak_timestamp_s": { "type": "number", "minimum": 0 },
        "openbar_peak_velocity_mps": { "type": "number" },
        "openbar_peak_timestamp_s": { "type": "number", "minimum": 0 },
        "peak_velocity_error_mps": { "type": "number" }
      }
    },
    "case_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "condition", "outcome", "reference_sample_count"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "condition": { "type": "string", "minLength": 1 },
        "outcome": { "enum": ["evaluated", "failed", "unsupported"] },
        "reference_sample_count": { "type": "integer", "minimum": 0 },
        "reference_uncertainty": { "$ref": "#/$defs/uncertainty" },
        "failure_reason": { "type": "string", "minLength": 1 },
        "metrics": { "$ref": "#/$defs/case_metrics" },
        "openbar_provenance": { "type": "object", "additionalProperties": true }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revised_threshold", "rationale", "evidence"],
      "properties": {
        "revised_threshold": { "type": "number", "exclusiveMinimum": 0 },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "original_threshold",
        "effective_threshold",
        "evaluated_case_count",
        "failed_supported_case_count",
        "rationale"
      ],
      "properties": {
        "status": { "enum": ["PASS", "FAIL", "REVISED"] },
        "original_threshold": { "type": "number", "exclusiveMinimum": 0 },
        "effective_threshold": { "type": "number", "exclusiveMinimum": 0 },
        "evaluated_case_count": { "type": "integer", "minimum": 0 },
        "failed_supported_case_count": { "type": "integer", "minimum": 0 },
        "error_distribution": { "$ref": "#/$defs/distribution" },
        "revision": { "$ref": "#/$defs/revision" },
        "meets_effective_target": { "type": "boolean" },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rom_mae_m", "mean_velocity_mae_mps", "peak_velocity_mae_mps"],
      "properties": {
        "rom_mae_m": { "$ref": "#/$defs/gate" },
        "mean_velocity_mae_mps": { "$ref": "#/$defs/gate" },
        "peak_velocity_mae_mps": { "$ref": "#/$defs/gate" }
      }
    }
  }
}
