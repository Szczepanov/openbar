{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbar.local/schemas/m0-evidence-v1.schema.json",
  "title": "OpenBar M0 evidence package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_version",
    "evaluated_commit",
    "scope",
    "candidate_configuration",
    "coverage",
    "annotation_repeatability",
    "tracker_results",
    "determinism",
    "environment",
    "gates",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_version": {
      "const": "m0-public-evidence-v1"
    },
    "evaluated_commit": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "const": "public_reproducible_subset"
    },
    "candidate_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trackers",
        "production_tracker_selected",
        "integration_probe_tracker",
        "filter",
        "production_filter_selected",
        "plate_diameter_m",
        "kinematics_method",
        "kinematics_max_gap_s",
        "kinematics_min_confidence",
        "benchmark_timestamp_tolerance_s",
        "benchmark_min_confidence"
      ],
      "properties": {
        "trackers": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "production_tracker_selected": {
          "type": "boolean"
        },
        "integration_probe_tracker": {
          "type": "string",
          "minLength": 1
        },
        "filter": {
          "type": "string",
          "minLength": 1
        },
        "production_filter_selected": {
          "type": "boolean"
        },
        "plate_diameter_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "kinematics_method": {
          "type": "string",
          "minLength": 1
        },
        "kinematics_max_gap_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "kinematics_min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "benchmark_timestamp_tolerance_s": {
          "type": "number",
          "minimum": 0
        },
        "benchmark_min_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "coverage": {
      "allOf": [
        {
          "$ref": "#/$defs/coverage"
        },
        {
          "required": [
            "fixture_manifest",
            "fixture_manifest_sha256"
          ]
        }
      ]
    },
    "annotation_repeatability": {
      "type": "object",
      "additionalProperties": true
    },
    "tracker_results": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "implementation",
          "metrics",
          "runtime",
          "warnings"
        ],
        "properties": {
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "metrics": {
            "type": "object",
            "additionalProperties": true
          },
          "runtime": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": true
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tracker_runs",
        "tracker_predictions_identical",
        "benchmark_repeats_per_tracker",
        "benchmark_outputs_identical",
        "canonical_analysis_runs",
        "canonical_analysis_identical"
      ],
      "properties": {
        "tracker_runs": {
          "type": "integer",
          "minimum": 2
        },
        "tracker_predictions_identical": {
          "type": "boolean"
        },
        "benchmark_repeats_per_tracker": {
          "type": "integer",
          "minimum": 2
        },
        "benchmark_outputs_identical": {
          "type": "boolean"
        },
        "canonical_analysis_runs": {
          "type": "integer",
          "minimum": 2
        },
        "canonical_analysis_identical": {
          "type": "boolean"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "os",
        "machine",
        "cpu",
        "python",
        "rustc",
        "cargo",
        "ffmpeg"
      ],
      "properties": {
        "os": {
          "type": "string"
        },
        "machine": {
          "type": "string"
        },
        "cpu": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "rustc": {
          "type": "string"
        },
        "cargo": {
          "type": "string"
        },
        "ffmpeg": {
          "type": "string"
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "target",
          "status",
          "evidence",
          "rationale"
        ],
        "properties": {
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT MEASURABLE YET",
              "REVISED"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": true
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "private_subset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "fixture_manifest_sha256",
        "build_profile",
        "coverage",
        "fixtures",
        "analysed_fixture_count",
        "determinism_pass",
        "runtime_diagnostics"
      ],
      "properties": {
        "scope": {
          "const": "private_local_subset_aggregates_only"
        },
        "fixture_manifest_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "build_profile": {
          "const": "release"
        },
        "coverage": {
          "$ref": "#/$defs/coverage"
        },
        "fixtures": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "exercise",
              "purpose",
              "status",
              "media_sha256",
              "redistribution_status",
              "seed",
              "annotation"
            ],
            "not": {
              "required": [
                "notes"
              ]
            },
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "exercise": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "minLength": 1
              },
              "nominal_fps": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "measured_fps": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "display_size_px": {
                "type": "string",
                "pattern": "^[0-9]+x[0-9]+$"
              },
              "duration_s": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "camera": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "view",
                  "movement"
                ],
                "properties": {
                  "view": {
                    "enum": [
                      "side",
                      "oblique_45",
                      "front",
                      "rear",
                      "unknown"
                    ]
                  },
                  "movement": {
                    "enum": [
                      "fixed",
                      "handheld",
                      "panning",
                      "moving_other",
                      "unknown"
                    ]
                  },
                  "approx_yaw_deg": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "approx_pitch_deg": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  },
                  "distance_m": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "motion_blur": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "occlusion": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "plate_visibility": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "lighting": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "challenge_tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                }
              },
              "media_sha256": {
                "type": "string",
                "pattern": "^[A-Fa-f0-9]{64}$"
              },
              "redistribution_status": {
                "type": "string",
                "minLength": 1
              },
              "seed": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "present"
                ],
                "properties": {
                  "present": {
                    "type": "boolean"
                  },
                  "selection_confidence": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              },
              "annotation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "present",
                  "comparable_labelled_samples"
                ],
                "properties": {
                  "present": {
                    "type": "boolean"
                  },
                  "comparable_labelled_samples": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              },
              "trackers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "implementation",
                    "status"
                  ],
                  "properties": {
                    "implementation": {
                      "type": "string",
                      "minLength": 1
                    },
                    "status": {
                      "enum": [
                        "ok",
                        "failed"
                      ]
                    },
                    "failure_reason": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9 .,()=+/_-]+$"
                    },
                    "observations": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "observed_range": {
                      "type": "string"
                    },
                    "selected_frames": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "tracked": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "low_confidence": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "lost": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "decode_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "track_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "selected_media_s": {
                      "type": "number",
                      "minimum": 0
                    },
                    "realtime_ratio": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "ok"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "observations",
                          "observed_range",
                          "selected_frames",
                          "tracked",
                          "low_confidence",
                          "lost",
                          "decode_s",
                          "track_s",
                          "selected_media_s",
                          "realtime_ratio"
                        ],
                        "not": {
                          "required": [
                            "failure_reason"
                          ]
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "status": {
                            "const": "failed"
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "failure_reason"
                        ]
                      }
                    }
                  ]
                }
              },
              "benchmarks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "benchmark_outputs_identical": {
                "type": [
                  "boolean",
                  "null"
                ]
              },
              "analysis": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "runs",
                  "identical",
                  "error"
                ],
                "properties": {
                  "runs": {
                    "type": "integer",
                    "minimum": 2
                  },
                  "identical": {
                    "type": [
                      "boolean",
                      "null"
                    ]
                  },
                  "error": {
                    "anyOf": [
                      {
                        "type": "null"
                      },
                      {
                        "type": "string",
                        "pattern": "^analyze-failed:[a-z-]+$"
                      }
                    ]
                  }
                }
              }
            },
            "$comment": "Aggregates only: manifest notes, frames and coordinates must never appear here."
          }
        },
        "analysed_fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "determinism_pass": {
          "type": "boolean"
        },
        "runtime_diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_count",
        "synthetic_fixture_count",
        "non_synthetic_fixture_count",
        "development_fixture_count",
        "held_out_fixture_count",
        "annotated_fixture_count",
        "held_out_real_annotated_fixture_count",
        "comparable_labelled_samples",
        "exercises",
        "missing_exercises",
        "nominal_fps",
        "camera_views",
        "camera_movements",
        "motion_blur_levels",
        "occlusion_levels",
        "lighting_conditions"
      ],
      "properties": {
        "fixture_manifest": {
          "type": "string",
          "minLength": 1
        },
        "fixture_manifest_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "synthetic_fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "non_synthetic_fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "development_fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "held_out_fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "annotated_fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "held_out_real_annotated_fixture_count": {
          "type": "integer",
          "minimum": 0
        },
        "comparable_labelled_samples": {
          "type": "integer",
          "minimum": 0
        },
        "exercises": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "missing_exercises": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "nominal_fps": {
          "type": "array",
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "camera_views": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "camera_movements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "motion_blur_levels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "occlusion_levels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lighting_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
